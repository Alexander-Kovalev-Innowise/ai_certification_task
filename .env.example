# Server
NODE_ENV=development
PORT=3000

# Database (docker-compose: postgres:16, see docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/practiceperfect

# Auth
JWT_SECRET=changeme-generate-a-strong-random-secret

# Scheduler (in-process @nestjs/schedule cron; emergency valve — arch §13.1)
SCHEDULER_ENABLED=true

# Client
NEXT_PUBLIC_API_URL=http://localhost:3000

SEED_SUPER_ADMIN_PASSWORD=ChangeMe123
SEED_SUPER_ADMIN_EMAIL=admin@example.com

# Mail: console | ses | smtp | dev (dev = in-memory mailbox at GET /__dev/mailbox, never in production)
MAIL_PROVIDER=console
SMTP_URL=smtp://user:pass@localhost:1025   # required when MAIL_PROVIDER=smtp
MAIL_FROM=no-reply@practiceperfect.local   # required when MAIL_PROVIDER=smtp
# Skip every rate limit (ignored when NODE_ENV=production) — for e2e suites
RATE_LIMITS_DISABLED=false
